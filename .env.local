# Langflow Environment Configuration
LANGFLOW_HOST=0.0.0.0
LANGFLOW_PORT=7860

# Use shared local PostgreSQL database (URL-encoded password)
LANGFLOW_DATABASE_URL=postgresql://db_admin:P%40ssw0rd123@database:5432/langflow

# Langflow specific settings
LANGFLOW_ENABLE_ANALYTICS=false
LANGFLOW_SUPERUSER=admin
LANGFLOW_SUPERUSER_PASSWORD=admin123
LANGFLOW_WORKERS=1
LANGFLOW_TIMEOUT=30

# Database connection settings for Azure PostgreSQL
LANGFLOW_DATABASE_POOL_SIZE=5
LANGFLOW_DATABASE_MAX_OVERFLOW=10
LANGFLOW_DATABASE_POOL_TIMEOUT=30
LANGFLOW_DATABASE_POOL_RECYCLE=3600

# Disable Redis completely to test database connection
LANGFLOW_CACHE_TYPE=memory
LANGFLOW_SESSION_TYPE=memory
# Remove any Redis URL references
# LANGFLOW_CACHE_URL=
# LANGFLOW_SESSION_URL=

# Custom components configuration
LANGFLOW_COMPONENTS_PATH=/app/langflow/custom_components

LANGFLOW_ENABLE_LANGCHAIN=true
LANGFLOW_ENABLE_LANGCHAIN_COMMUNITY=true
LANGFLOW_ENABLE_LANGCHAIN_EXPERIMENTAL=true
LANGFLOW_ENABLE_OPENAI=true
LANGFLOW_ENABLE_ANTHROPIC=true
LANGFLOW_ENABLE_GOOGLE=true
LANGFLOW_ENABLE_AZURE=true
LANGFLOW_ENABLE_HUGGINGFACE=true